{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "AI Infrastructure Anomaly Detection",
  "tags": ["ai", "anomaly-detection", "ml"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Active Anomaly Flag (1=Active, 0=Normal)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ai_anomaly_flag",
          "legendFormat": "Anomaly Status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NORMAL", "color": "green" }, "1": { "text": "ANOMALY DETECTED", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Isolation Forest Anomaly Score",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "ai_anomaly_score",
          "legendFormat": "Decision Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Total Metric Evaluations Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "ai_metric_evaluations_total",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    }
  ]
}
