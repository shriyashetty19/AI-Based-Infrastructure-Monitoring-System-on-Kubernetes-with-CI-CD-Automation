# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# ML Detector Settings
ML_PORT=8001
PROMETHEUS_URL=http://prometheus-k8s.monitoring.svc.cluster.local:9090
CONTAMINATION_FACTOR=0.05
Z_SCORE_THRESHOLD=3.0

# AWS & Registry Credentials (Placeholders for local development / Jenkins secrets binding)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
ECR_REGISTRY_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com

# Kubernetes Settings
KUBECONFIG_PATH=~/.kube/config
K8S_NAMESPACE=ai-monitoring
